{
  "name": "bgenhanced",
  "version": "0.3.15",
  "private": true,
  "description": "BetterNCM 背景增强插件（纯前端）",
  "license": "MIT",
  "scripts": {
    "build": "node ./build.js",
    "build:dev": "node ./build.js --dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "pack": "npm run build && node ./scripts/pack.js --no-build",
    "pack:only": "node ./scripts/pack.js --no-build"
  },
  "dependencies": {
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "esbuild": "^0.19.4",
    "esbuild-sass-plugin": "2.16.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.7.1",
    "sweetalert2": "^11.6.16",
    "typescript": "^4.9.4"
  }
}
